# Local environment variables — never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret

APP_ENV=development
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_HOURS=8

DB_HOST=localhost
